#!/bin/sh
set -e

# Arcadia OS build hook: enable the 32-bit (i386) architecture and install
# Steam plus the 32-bit graphics/Wine libraries that many games still need.
#
# This runs AFTER the package lists are installed, so `apt` is fully
# configured and the archive areas (contrib/non-free) are available.

echo "I: [arcadia] enabling i386 multiarch and installing Steam"

dpkg --add-architecture i386
apt-get update

export DEBIAN_FRONTEND=noninteractive

# Steam Debian package (non-free). steam-installer pulls the bootstrap that
# self-updates on first launch.
apt-get install -y --no-install-recommends steam-installer || \
	apt-get install -y --no-install-recommends steam || true

# 32-bit graphics + Wine libraries for older/32-bit titles and Proton.
apt-get install -y \
	libgl1-mesa-dri:i386 \
	libglx-mesa0:i386 \
	mesa-vulkan-drivers:i386 \
	libvulkan1:i386 \
	wine32:i386 \
	|| echo "W: [arcadia] some 32-bit libraries were unavailable; continuing"

apt-get clean
