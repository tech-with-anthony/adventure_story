#!/bin/sh
set -e

# Arcadia OS build hook: best-effort install of "nice to have" gaming tools
# whose package names occasionally change between Debian releases. Each is
# installed individually so a single missing package never fails the build.

echo "I: [arcadia] installing best-effort gaming extras"
export DEBIAN_FRONTEND=noninteractive

for pkg in \
	gamescope \
	goverlay \
	vkbasalt \
	protontricks \
	corectrl \
	piper \
	pcsx2 \
	ppsspp \
	xboxdrv \
	steam-devices
do
	if apt-get install -y --no-install-recommends "$pkg"; then
		echo "I: [arcadia]   + $pkg"
	else
		echo "W: [arcadia]   - $pkg unavailable, skipped"
	fi
done

apt-get clean
