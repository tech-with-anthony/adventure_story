#!/bin/sh
set -e

# Arcadia OS build hook: enable the right services and apply gaming tweaks
# that need commands (not just dropped-in files).

echo "I: [arcadia] enabling services and applying tweaks"

# Boot to the graphical login manager.
systemctl set-default graphical.target || true

# Core services.
for svc in sddm NetworkManager bluetooth; do
	systemctl enable "$svc" 2>/dev/null || echo "W: [arcadia] could not enable $svc"
done

# GameMode: the daemon is started on demand over D-Bus by games, but make sure
# the account that launches it can request the performance governor.
systemctl --global enable gamemoded.service 2>/dev/null || true

# Make the drop-in gaming sysctl/limits owned by root with sane perms.
chmod 0644 /etc/sysctl.d/99-arcadia-gaming.conf 2>/dev/null || true
chmod 0644 /etc/security/limits.d/99-arcadia-gaming.conf 2>/dev/null || true

# Ensure the helper scripts are executable.
chmod 0755 /usr/local/bin/arcadia-welcome \
	/usr/local/bin/arcadia-install-extras \
	/usr/local/bin/arcadia-nvidia 2>/dev/null || true
