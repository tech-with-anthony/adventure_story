# Arcadia OS — Graphics stack, Vulkan & firmware
#
# The open Mesa stack (AMD/Intel) is installed by default. NVIDIA's proprietary
# driver is offered to the user post-install via `arcadia-nvidia` rather than
# baked in, because it must match the specific GPU/kernel.

# --- Mesa / OpenGL / Vulkan (64-bit) ---
mesa-utils
mesa-vulkan-drivers
libvulkan1
vulkan-tools
vulkan-validationlayers
libgl1-mesa-dri
libglx-mesa0
libegl-mesa0

# --- VA-API / hardware video acceleration ---
mesa-va-drivers
mesa-vdpau-drivers
vainfo
vdpau-driver-all
intel-media-va-driver-non-free

# --- Firmware (Wi-Fi, GPU microcode, Bluetooth) ---
firmware-linux
firmware-linux-nonfree
firmware-misc-nonfree
firmware-realtek
firmware-iwlwifi
firmware-atheros
amd64-microcode
intel-microcode

# --- Kernel headers (needed to build the NVIDIA/DKMS drivers later) ---
linux-headers-amd64
