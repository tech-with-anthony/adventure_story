#!/bin/sh
set -e

# Arcadia OS — install optional extra gaming apps on demand (post-install).
# Uses Flatpak so it works without touching the base system.

if ! command -v flatpak >/dev/null 2>&1; then
	echo "flatpak is not installed." >&2
	exit 1
fi

flatpak remote-add --if-not-exists flathub \
	https://flathub.org/repo/flathub.flatpakrepo

echo "Installing optional gaming apps from Flathub..."
for app in \
	com.discordapp.Discord \
	com.heroicgameslauncher.hgl \
	com.usebottles.bottles \
	net.davidotek.pupgui2 \
	com.moonlight_stream.Moonlight \
	io.mgba.mGBA \
	org.prismlauncher.PrismLauncher
do
	printf '  %-40s ' "$app"
	if flatpak install -y --noninteractive flathub "$app" >/dev/null 2>&1; then
		echo "ok"
	else
		echo "skipped"
	fi
done

echo "Done. Launch the new apps from your application menu."
