#!/bin/sh
set -e

# Arcadia OS — install the proprietary NVIDIA driver (post-install).
# Kept out of the ISO because the correct driver depends on the specific GPU
# and running kernel; DKMS builds it against the installed headers.

if [ "$(id -u)" -ne 0 ]; then
	echo "Please run with sudo:  sudo arcadia-nvidia" >&2
	exit 1
fi

echo "Detected GPU(s):"
lspci | grep -i -E 'vga|3d|display' || true
echo

printf 'Install the proprietary NVIDIA driver now? [y/N] '
read -r answer
case "$answer" in
	y|Y|yes|YES) ;;
	*) echo "Aborted."; exit 0 ;;
esac

apt-get update
# nvidia-driver pulls the right module via DKMS + the 32-bit libs for Steam.
DEBIAN_FRONTEND=noninteractive apt-get install -y \
	nvidia-driver \
	nvidia-driver-libs:i386 \
	nvidia-settings

echo
echo "NVIDIA driver installed. Reboot to load it."
