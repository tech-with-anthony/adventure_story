#!/bin/sh

# Arcadia OS — live-build configuration
# Debian-based gaming distribution.
#
# This file is executed by `lb config`. It sets the global options for the
# image: which Debian suite to build from, which apt areas to enable, the
# bootloader/installer behaviour and the ISO branding metadata.

set -e

lb config noauto \
	--mode debian \
	--distribution trixie \
	--archive-areas "main contrib non-free non-free-firmware" \
	--architectures amd64 \
	--linux-flavours amd64 \
	--debian-installer live \
	--debian-installer-gui true \
	--bootappend-live "boot=live components username=gamer hostname=arcadia quiet splash" \
	--memtest none \
	--apt-recommends true \
	--firmware-chroot true \
	--firmware-binary true \
	--iso-application "Arcadia OS" \
	--iso-volume "Arcadia OS 1.0" \
	--iso-preparer "Arcadia Project; https://www.debian.org/devel/debian-live" \
	--iso-publisher "Arcadia Project" \
	"${@}"
